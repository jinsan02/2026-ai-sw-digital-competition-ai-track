*.pkl
*.pt
*.bin
*.safetensors
model/
model_*/
submit/model/
experiments/cache/
experiments/logits/
runs/

# 파이썬 환경 / 산출물
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 압축 / 제출물 / 추론 출력
*.zip
*.tar.gz
submissions/
output/

# 하네스 로그 / IDE / OS
